# Copy to api/.env (git-ignored). NEVER commit real keys.
PORT=8787
CHAIN_ID=42220
RPC_URL=https://forno.celo.org
# BountyBoard address from the stage 2 deployment
BOUNTY_BOARD=0x0000000000000000000000000000000000000000
# Hot key that only pays gas for claimFor/submitFor. Fund it with a little CELO. It has no power over
# bounties or funds: every action needs the worker's own EIP-712 signature.
RELAYER_PRIVATE_KEY=0x
# Token of the Telegram bot that hosts the Mini App (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
CORS_ORIGIN=*
INITDATA_MAX_AGE_SECONDS=3600
# Approximate naira value of 1 G$ (shown beside amounts)
NGN_PER_GD=0.15

# CELO top-up so a new worker can pay gas for the one-time G$ approval. OFF by default.
TOPUP_ENABLED=false
TOPUP_AMOUNT_CELO=0.01
TOPUP_MIN_BALANCE_CELO=0.005
# Max CELO given away per rolling 24h across all workers
TOPUP_DAILY_CAP_CELO=1
