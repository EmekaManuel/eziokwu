# Copy to .env (git-ignored) and fill in. NEVER put a private key in this file.
# Deployer key is supplied at the command line: `--account <keystore name>` (preferred).
# Create one with: cast wallet import eziokwu-deployer --interactive

# dev   = Celo mainnet + GoodDollar DEVELOPMENT G$ / Identity (testing)
# prod  = Celo mainnet + GoodDollar PRODUCTION G$ / Identity
# local = other chain (anvil): deploys mock G$ + Identity
DEPLOY_ENV=dev

# Admin of the contract (use a multisig for prod; ownership transfer is two-step)
OWNER=0x0000000000000000000000000000000000000000
# Backend address allowed to call resolve(). Zero disables the role.
VERIFIER=0x0000000000000000000000000000000000000000
# UBI Pool address. TODO: confirm with the GoodBuilders team before prod.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# Fee in basis points, max 500 (5%)
FEE_BPS=300

# RPC and block explorer (Celo mainnet)
CELO_RPC_URL=https://forno.celo.org
CELOSCAN_API_KEY=
