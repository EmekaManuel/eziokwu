# Public (browser-visible) settings. No secrets here.
NEXT_PUBLIC_API_URL=https://attract-myself-gourmet-hawaiian.trycloudflare.com
NEXT_PUBLIC_BOUNTY_BOARD=0x0000000000000000000000000000000000000000
# dev = GoodDollar development contracts, prod = production
NEXT_PUBLIC_DEPLOY_ENV=dev
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
# https://cloud.reown.com (free). Needed so workers can connect a mobile wallet from inside Telegram.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
